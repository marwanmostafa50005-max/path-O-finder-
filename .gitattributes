# Cross-platform byte-identity: never let autocrlf rewrite files that tests
# compare byte-for-byte or that parsers consume as-is.

* text=auto

# Golden files and configs are compared/parsed byte-identically on Windows.
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.spec  text eol=lf

# Windows-native tooling expects CRLF.
*.ps1   text eol=crlf
*.iss   text eol=crlf

# Binary — no translation ever.
*.png   binary
*.svg   text eol=lf
*.ico   binary
*.ttf   binary
*.pdf   binary
*.gguf  binary
*.db    binary
